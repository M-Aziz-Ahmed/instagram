# live-server environment for a Linux host.
#
#   sudo install -o anontweet -g anontweet -m 600 env.example /opt/anontweet-live-server/.env
#   sudo nano /opt/anontweet-live-server/.env
#
# Every secret here ends up on one machine. None of these should be committed, and
# none of them should ever be shipped inside a desktop installer: MONGODB_URI grants
# full read/write on the database, and the API secrets grant control of media,
# email and push.

# ── Required ─────────────────────────────────────────────────────────────────

# Generate with: openssl rand -hex 32
JWT_SECRET=

# The shared database. Every live-server instance - central and any desktop
# sidecar - points at the same one.
MONGODB_URI=

# ── Strongly recommended ─────────────────────────────────────────────────────

# Encrypts stored Google Drive OAuth tokens. MUST be set explicitly rather than
# left to fall back to JWT_SECRET: rotating JWT_SECRET would then orphan every
# stored token and users would have to re-link Drive. Generate separately.
MEDIA_VAULT_SECRET=

# Signs session cookies. The operator named here is promoted to admin at login.
ADMIN_EMAIL=

# ── Shared bus (only needed for more than one instance) ──────────────────────

# Without Redis the server runs correctly as a single instance: socket rooms and
# rate-limit counters are process-local. With several instances, Redis is required
# or calls, voice, games and live streams will not be delivered across them.
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379

# 2 works with every Redis release. 3 needs Redis >= 6.0.
REDIS_RESP=2

# Pool size is per process and multiplies by instance count. Keep this modest if
# desktop instances may connect.
MONGO_POOL_MAX=50
MONGO_POOL_MIN=10

# ── Web ──────────────────────────────────────────────────────────────────────

PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://anontweet.vercel.app

# ── Media moderation ─────────────────────────────────────────────────────────
# Absent, moderation is skipped entirely and everything is treated as clean.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLOUD_VISION_API_KEY=

# ── Email (OTP login) ────────────────────────────────────────────────────────

GMAIL_USER=
GMAIL_APP_PASSWORD=
BREVO_API_KEY=

# ── Web push ─────────────────────────────────────────────────────────────────

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ── Push for the native apps ─────────────────────────────────────────────────

FIREBASE_SERVICE_ACCOUNT_PATH=

# ── Feature switches ─────────────────────────────────────────────────────────
# Leave ADMIN_RESTART unset: POST /api/admin/system/restart is only enabled when
# it is exactly "true".

ALLOW_RESTART=

# ── Optional ─────────────────────────────────────────────────────────────────

# Enable on the central host only. It disables the third-party WarEra tracker,
# which harvests another game's API and auto-messages its players. It must never
# run from a desktop instance.
SIDECAR_MODE=

# Chat TTL index, in days.
CHESS_GAME_TTL_DAYS=90
