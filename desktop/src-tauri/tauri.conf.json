{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnonTweet",
  "version": "0.2.20",
  "identifier": "com.anontweet.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AnonTweet",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "url": "https://anontweet.vercel.app",
        "resizable": true,
        "center": true
      }
    ],
"security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3NjM5MjE3QTRERTE3RTMKUldUakY5NmtGNUpqcDBFVC9VZStQQ01lUWRkUk1yanMzVHErbU90RThoNmp0dHZJU0FoTXJlWHcK",
      "endpoints": [
        "https://anontweet.vercel.app/downloads/desktop/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
