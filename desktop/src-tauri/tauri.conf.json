{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnonTweet",
  "version": "0.1.0",
  "identifier": "com.anontweet.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AnonTweet",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "url": "https://anontweet.vercel.app",
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}