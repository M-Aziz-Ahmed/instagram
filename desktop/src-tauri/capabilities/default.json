{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main AnonTweet window and toast notification windows",
  "local": true,
  "remote": {
    "urls": ["https://anontweet.vercel.app"]
  },
  "windows": ["main", "toast-*"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-create",
    "core:webview:allow-create-webview-window",
    "updater:default",
    "process:default",
    "notification:default",
    "allow-show-toast",
    "allow-close-toast",
    "allow-handle-toast-click"
  ]
}